{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "vuelos": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "index.html",
            "browser": "main.ts",
            "tsConfig": "tsconfig.json",
            "styles": []
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "vuelos:build" }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
